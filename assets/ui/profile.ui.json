    "layout": {
      "header": "titleY52,size26; width=min(W-40,max(136,2*26+44))=136; plaque[133.6,31.2,136,41.6]",
      "category": "startX=(W-(90*2+8))/2=107.6;y88;pills90x44,gap8",
      "previewTop": "88+44+12=144",
      "bottom": "H-56=840",
      "gridTop": "144+floor(min(250,(840-144)*0.36))=394",
      "cols": "max(1,floor((W-48+14)/(76+14)))=4",
      "cellH": "76+22=98",
      "needed": "26+ceil(count/cols)*98+max(0,ceil(count/cols)-1)*16; skins352,backgrounds238",
      "paged": "needed>bottom-gridTop is false for both lists; gridBottom840; pages1; no pager drawn",
      "rows": "max(1,floor((gridBottom-gridTop-26+16)/(98+16)))=3;capacity12",
      "startX": "(W-(cols*76+(cols-1)*14))/2=28.6",
      "tile": "x=startX+(index%cols)*90;y=gridTop+14+floor(index/cols)*114;hit76x98;paper76x76,radius11;label center[x+38,y+90]",
      "characterPreview": "areaH250;size=min(200,250-36-20,W-80)=194;x104.6;y144+(250-(194+36))/2=154+sin(t*1.5)*3;contain",
      "characterName": "centerY154+194+16=364;source font16 measured name width32; pill68x28,radius14;check centerX=W/2+32/2+12=229.6",
      "backgroundPreview": "height=max(60,gridTop-previewTop-48)=202;width=height*9/20=90.9;x156.15;y150;Paper.panel outer[x-3,y-3,width+6,height+6]",
      "backgroundName": "centerY150+202+14=366;font14,name width56;plaque84x28,stroke1.5",
      "backgroundThumbnail": "postcard31.5x70 at tile+[22.25,3];source renderBackground(200,200*20/9) selects previewImage (w<=216,h<=480),not square cover",
      "paginationFormula": "Other sizes: if paged gridBottom=bottom-56; rows=floor((gridBottom-gridTop-26+16)/114),capacity=rows*cols,pages=ceil(count/capacity);previous[24,bottom-50,90,44],next[W-114,bottom-50,90,44];indicator center[W/2,bottom-28]. Not visible at snapshot.",
      "bar": "bottom0,height56;page y840"
    },
    "paletteSource": "scripts/shared/constants/art.lua:colors; locked tint[255,246,220,90]; selected outline orange3,other ink2;thumb alpha1/.55",
    "bindings": [
      {
        "id": "profile-background",
        "fields": [
          "backgroundImage",
          "backgroundColor"
        ],
        "lua": "bgManager.getCurrent().themeImage / .colors.base",
        "source": "scripts/shared/background-manager.lua:BACKGROUNDS/getCurrent/renderBackground",
        "default": "image/handdrawn/backgrounds/default.png"
      },
      {
        "ids": [
          "profile-character-preview",
          "profile-character-name"
        ],
        "fields": [
          "backgroundImage",
          "text"
        ],
        "lua": "selectedId_=OutfitManager.getCurrent();previewFor(vg,selectedId_)->skin.texture;OutfitManager.getCurrentName()",
        "source": "scripts/pages/profile/init.lua:renderPreview; scripts/shared/outfit-manager.lua:SKINS",
        "defaultTexture": "Textures/character/fox.png",
        "defaultName": "默认"
      },
      {
        "ids": [
          "category-character",
          "category-background",
          "profile-character-content",
          "profile-background-content"
        ],
        "lua": "category_;categoryFade_=0 then min(1,categoryFade_+dt*8)",
        "source": "scripts/pages/profile/init.lua:renderCategoryBar/renderAll/handleClickAt",
        "fields": [
          "content.visible",
          "plaque.backgroundColor"
        ],
        "rule": "Selected category visible;active plaque orange,other paper;content opacity0.65+0.35*categoryFade_."
      },
      {
        "id": "profile-skin-grid",
        "lua": "OutfitManager.getAllSkins();isUnlocked(skin.id);getLockReason(skin.id);selectedId_;gridPage_.character",
        "source": "scripts/pages/profile/init.lua:renderGrid; scripts/shared/outfit-manager.lua:SKINS",
        "fields": [
          "per-skin image=skin.thumbnail or skin.texture",
          "label=unlocked and skin.name or getLockReason(id).label",
          "imageOpacity=unlocked and1 or.55",
          "lock/tint visible=not unlocked",
          "selected orange3/check=selected and unlocked"
        ],
        "action": "Unlocked->selectSkin;purchase-type locked->PurchasePopup.show. Locked Buttons remain enabled, matching source purchase hit handling."
      },
      {
        "ids": [
          "profile-background-preview",
          "profile-background-name"
        ],
        "fields": [
          "backgroundImage",
          "text"
        ],
        "lua": "bgManager.getCurrent().previewImage/.name;themeImage fallback if no preview",
        "source": "scripts/pages/profile/init.lua:renderBgPreview; scripts/shared/background-manager.lua:renderBackground"
      },
      {
        "id": "profile-background-grid",
        "lua": "bgManager.getAll();getUnlockLabel(id);isUnlocked(id);selectedBgId_;gridPage_.background",
        "source": "scripts/pages/profile/init.lua:renderBgGrid",
        "fields": [
          "image=bg.previewImage",
          "label=unlocked and bg.name or getUnlockLabel(bg.id);purchase overrides yuan price",
          "lock/tint visible=not unlocked",
          "selected orange3/check=selected and unlocked"
        ],
        "action": "Unlocked->bgManager.select;purchase locked->cloudAge check then bgManager.purchase"
      },
      {
        "id": "bottom-tabs",
        "component": "ui/bottom-tabs.ui.json",
        "lua": "activeTab=profile;lockedTabs=Storyline.getNodeState('story-4')~='done' and {home=true} or nil",
        "source": "scripts/shared/components/tab-bar.lua:renderHanddrawn"
      }
    ],
    "layerOrder": [
      "page selected background",
      "header",
      "category buttons",
      "selected preview + name/check",
      "grid paper/rule",
      "tile plaque,image,locked tint/body/shackle,outline,selected circle/check,label",
      "pagination only if pages>1 (not drawn)",
      "bottom tabs",
      "purchase/settings overlays only if opened (omitted)"
    ],
    "limitations": [
      "Static editor extraction only; no entry/gameplay/Lua changes. _extraction metadata is not executable bindings; Buttons have IDs but no callbacks.",
      "Cloud state cannot be inferred offline. Default skin/background,no purchases,no story progress are explicit snapshot assumptions.",
      "Hidden background category is an editable alternative in the same JSON; category switching requires future Lua binding.",
      "Pen.plaque quadratic corners approximated by Panel borderRadius11; strokes/colors/bounds preserved. Vector checks/lock arcs approximate with editable rotated/rounded Panels.",
      "Portrait contain preserved; background postcards use previewImage9:20 cover,not square-cropped themes.",
      "Name widths measured from source font via FreeType; exact NVG glyph positions and editor sans may differ.",
      "Density-effective403.2x896 canvas;percent widths/bottom56 retained. Other sizes need recorded dynamic min/floor/text-measure formulas recomputed.",
      "Outfit switch animation,category fade,dynamic pagination,purchase/settings overlays remain original Lua-owned behavior.",
      "Tabs independently copied from bottom-tabs.ui.json without custom component registration; gear approximation documented there.",
      "JSON/reference validation only; no build or runtime screenshot."
    ]
  },
