        "default": "Textures/character/fox.png"
      },
      {
        "idPattern": "game-{gameId}",
        "lua": "gameRegistry.getGameList(); Router.push('game',{gameConfig=config}) after restriction check",
        "source": "scripts/pages/home/init.lua:renderGrid/handleClickAt",
        "fields": [
          "paper fill by registry index",
          "icon.backgroundImage=Art.gameIcons[config.gameId]",
          "title.text=config.title",
          "subtitle.text=config.subtitle"
        ]
      },
      {
        "id": "bottom-tabs",
        "component": "ui/bottom-tabs.ui.json",
        "source": "scripts/shared/components/tab-bar.lua:renderHanddrawn",
        "lua": "activeTab=home; lockedTabs=Storyline.getNodeState('story-4')~='done' and {home=true} or nil"
      }
    ],
    "layerOrder": [
      "selected background",
      "header shadow + paper + title + subtitle",
      "game cards: shadow,paper,icon,title,subtitle,optional badge",
      "fox portrait then transient greeting",
      "bottom tabs",
      "PlayTimeGuard overlay when restricted (omitted)",
      "UI settings/anti-addiction popup when open (omitted)"
    ],
    "limitations": [
      "Static extraction only; existing Lua/route/input/cloud/gameplay unchanged. Metadata describes bindings but does not execute them.",
      "Pen.plaque quadratic corners approximated by rounded Panel11; fills, centered stroke widths, bounds and offset shadows follow source.",
      "Only Panel/Label/Button; images assets-relative. No new images, callback code or invented NanoVG JSON schema.",
      "Numeric403.2x896 canvas; width percentages and bottom56 fixed retained. Other sizes require recomputing recorded min/floor/text-measure formulas.",
      "sans metrics may differ from source font. Buttons have no callbacks; UI theme may still affect inherited properties.",
      "Transient greeting/random chat, animation, restrictions and modal overlays remain Lua-owned, not fabricated visible permanent controls.",
      "Bottom tabs are an independent built-in-Widget copy, not a custom component requiring entry registration. Gear/lock contour approximations documented in bottom-tabs.ui.json.",
      "JSON/reference validation only; no build or runtime screenshot."
    ]
  },
