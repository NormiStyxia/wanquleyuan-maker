      {
        "sourceFaces": [
          "menu",
          "fox-mascot"
        ],
        "path": "Fonts/LongZhuTi-Regular.ttf",
        "jsonFontFamily": "sans",
        "note": "Source registration remains Lua-owned. Identical glyph metrics need external sans mapping to this source font; no font registration changed."
      }
    ],
    "snapshot": {
      "backgroundId": "default",
      "skinId": "default",
      "gameCount": 4,
