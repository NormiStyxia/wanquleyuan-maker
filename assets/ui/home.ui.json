      "animationTime": 0,
      "overlay": "PlayTimeGuard unrestricted; settings/anti-addiction popups closed"
    },
    "layout": {
      "titleStart": "MENU_START_Y+MENU_TITLE_GAP=16+30=46; titleY=curY+28=74",
      "titlePlate": "w=min(W-40,max(136,utf8.len(title)*30+44))=164; rectangle[119.6,50,164,48]",
      "subtitle": "center=[W/2,117],font14",
      "gridY": "74+30*0.8+34+MENU_GRID_GAP=146",
      "tile": "min((W-24*2-16)/2,H*0.28)=169.6",
      "gridOffsetX": "24+((W-48)-(tile*2+16))/2=24",
      "grid": "2cols,2rows; x=gridOffsetX+col*(tile+16); y=146+row*(tile+16)",
      "icon": "size=min(98,tile*0.54)=91.584; center=[tile/2,tile*0.34]",
      "text": "title centerY=tile*0.69,size=min(18,tile*0.12)=18; subtitle centerY=tile*0.85,size=min(12,tile*0.078)=12",
      "mascot": "size=H<720 and100 or128; x=-21; y=H-56-4-size+sin(t*FOX_FLOAT_SPEED)*2; snapshot y708; drawn BEFORE tabs",
      "mascotHitTest": "Source handleClickAt calls hitTest without size options, so input uses default160 versus render128. Not silently corrected here.",
      "greeting": "Transient and omitted from settled snapshot. textX=foxX+size+6; textBottom=foxY+size-4-72; maxW=max(60,min(180,W-textX-16)); measured via NVG/kinsoku; needs Lua state machine.",
      "bar": "bottom=0,height=56 effective units; page barY=840"
    },
    "gameOrder": {
      "frozen": [
        "p1-puzzle-land",
        "p4-link-match",
        "p3-match-3",
        "p2-memory-flip"
      ],
      "sort": "sortWeight descending only:100,75,75,70. p3/p4 have equal75 and table.sort is unstable; frozen valid Lua introsort order is p1,p4,p3,p2, not a portable secondary sort contract.",
      "badges": "None: source configs do not enable isNew/isHot."
    },
    "bindings": [
      {
        "id": "home-background",
        "fields": [
          "backgroundImage",
          "backgroundColor"
        ],
        "lua": "bgManager.getCurrent().themeImage / .colors.base",
