      "densityReferenceHeight": 896,
      "densityFactor": 1.3392857142857142,
      "effectiveSize": [
        403.2,
        896
      ],
      "offsetX": 0,
      "formula": "factor=clamp((physicalH/DPR)/896,0.85,2.5); scale=DPR*factor; fullW=physicalW/scale; fullH=physicalH/scale; gameW=min(fullW,fullH/1.2); offsetX=(fullW-gameW)/2",
      "editorCanvas": "403.2 x 896 effective NVG units, not 540 x 1200 raw coordinates. Physical presentation scales every unit by1200/896 at the assumed viewport.",
