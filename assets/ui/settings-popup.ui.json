    "dependencies": ["scripts/shared/components/paper-ui.lua", "scripts/shared/constants/art.lua", "scripts/shared/constants/colors.lua", "scripts/shared/settings-save.lua", "scripts/shared/cloud-age.lua", "scripts/config/compliance.lua"],
